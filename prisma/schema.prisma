generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FacilityStatus {
  AVAILABLE
  UNDER_MAINTENANCE
}

enum ReservationStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum EquipmentReturnStatus {
  BORROWED
  RETURNED
}

enum Role {
  USER
  ADMIN
}

enum AdminRole {
  CORE_ADMIN
  ADMIN
}

model Admin {
  adminId       Int           @id @default(autoincrement()) @map("Admin_ID")
  name          String        @db.VarChar(191) @map("Name")
  birthdate     DateTime?     @db.Date @map("Birthdate")
  gender        String        @db.VarChar(50) @map("Gender")
  address       String?       @db.VarChar(191) @map("Address")
  username      String        @unique @db.VarChar(191) @map("Username")
  password      String        @db.VarChar(191) @map("Password")
  contactNumber String        @db.VarChar(50) @map("Contact number")
  email         String        @db.VarChar(191) @map("email")
  role          AdminRole     @default(ADMIN) @map("Role")
  isActive      Boolean       @default(true) @map("Is_Active")
  createdAt     DateTime      @default(now()) @map("CreatedAt")
  deactivatedAt DateTime?     @map("DeactivatedAt")
  equipment     Equipment[]
  reservation   Reservation[]
  facility      Facility[]
  sessions      AppSession[]

  @@map("Admin")
}

model User {
  userId        Int           @id @default(autoincrement()) @map("User_ID")
  name          String        @db.VarChar(191) @map("Name")
  birthdate     DateTime?     @db.Date @map("Birthdate")
  gender        String        @db.VarChar(50) @map("Gender")
  address       String?       @db.VarChar(191) @map("Address")
  username      String        @unique @db.VarChar(191) @map("Username")
  password      String        @db.VarChar(191) @map("Password")
  contactNumber String        @db.VarChar(50) @map("Contact number")
  email         String        @db.VarChar(191) @map("email")
  role          Role          @default(USER) @map("Role")
  isActive      Boolean       @default(true) @map("Is_Active")
  deactivatedAt DateTime?     @map("DeactivatedAt")
  reservation   Reservation[]
  sessions      AppSession[]

  @@map("User")
}

model Equipment {
  equipmentId Int           @id @default(autoincrement()) @map("Equipment_ID")
  adminId     Int           @map("Admin_ID")
  itemName    String        @db.VarChar(191) @map("Item_Name")
  description String?       @db.VarChar(191) @map("Description")
  price       Decimal?      @map("Price")
  quantity    Int?          @map("Quantity")
  admin       Admin         @relation(fields: [adminId], references: [adminId], onDelete: Restrict, onUpdate: Cascade)
  reservation Reservation[]

  @@index([adminId])
  @@map("Equipment")
}

model Facility {
  facilityId  Int             @id @default(autoincrement()) @map("Facility_ID")
  adminId     Int             @map("Admin_ID")
  itemName    String          @db.VarChar(191) @map("Item Name")
  description String?         @db.VarChar(191) @map("Desciption")
  status      FacilityStatus  @default(AVAILABLE) @map("Status")
  pricePerDay Int             @map("Priceperday")
  admin       Admin           @relation(fields: [adminId], references: [adminId], onDelete: Restrict, onUpdate: Cascade)
  reservation Reservation[]

  @@index([adminId])
  @@map("Facility")
}

model Reservation {
  reservationId     Int               @id @default(autoincrement()) @map("Reservation_ID")
  userId            Int               @map("User_ID")
  equipmentId       Int?              @map("Equipment_ID")
  adminId           Int?              @map("Admin_ID")
  facilityId        Int?              @map("Facility_ID")
  startDateTime     DateTime          @map("Start_DateTime")
  endDateTime       DateTime          @map("End_DateTime")
  purpose           String            @db.VarChar(191) @map("Purpose")
  status            ReservationStatus @default(PENDING) @map("Status")
  expectedAttendees Int?              @map("Expected_Attendees")
  equipmentQuantity Int?              @map("Equipment_Quantity")
  approvedAt        DateTime?         @map("ApprovedAt")
  returnedAt        DateTime?         @map("ReturnedAt")
  cancelledAt       DateTime?         @map("CancelledAt")
  returnStatus      EquipmentReturnStatus? @map("Return_Status")
  adminNotes        String?           @db.VarChar(191) @map("Admin_Notes")
  user              User              @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  equipment         Equipment?        @relation(fields: [equipmentId], references: [equipmentId], onDelete: SetNull, onUpdate: Cascade)
  admin             Admin?            @relation(fields: [adminId], references: [adminId], onDelete: SetNull, onUpdate: Cascade)
  facility          Facility?         @relation(fields: [facilityId], references: [facilityId], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([equipmentId])
  @@index([adminId])
  @@index([facilityId])
  @@unique([userId, facilityId, startDateTime, endDateTime])
  @@unique([userId, equipmentId, startDateTime, endDateTime])
  @@map("Reservation")
}

model AppSession {
  sessionId    String   @id @db.VarChar(191) @map("Session_ID")
  role         Role     @map("Role")
  username     String   @db.VarChar(191) @map("Username")
  userId       Int?     @map("User_ID")
  adminId      Int?     @map("Admin_ID")
  createdAt    DateTime @default(now()) @map("CreatedAt")
  lastActivity DateTime @map("LastActivity")
  expiresAt    DateTime @map("ExpiresAt")
  ipAddress    String?  @db.VarChar(191) @map("IP_Address")
  userAgent    String?  @db.VarChar(191) @map("User_Agent")
  user         User?    @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
  admin        Admin?   @relation(fields: [adminId], references: [adminId], onDelete: Cascade, onUpdate: Cascade)

  @@index([expiresAt])
  @@index([username])
  @@index([role, userId])
  @@index([role, adminId])
  @@map("AppSession")
}
