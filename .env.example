# Own Next.js API routes should stay relative (/api/...).
# If you set a public app URL, use the site origin only.
# For Supabase on Vercel, use the pooled runtime URL in DATABASE_URL.
# If you have a direct Supabase connection string available, set DIRECT_URL too for migrations and seeds.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
APP_URL="https://ACTUAL_DEPLOYED_VERCEL_APP_URL.vercel.app"
NEXT_PUBLIC_API_URL="https://ACTUAL_DEPLOYED_VERCEL_APP_URL.vercel.app"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_or_service_role_key_here"
SESSION_BIND_USER_AGENT="false"
SESSION_BIND_IP="false"
# Gmail SMTP configuration. Use a Gmail App Password here, not your regular Gmail password.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="Barangay Facility & Equipment Reservation System <your-email@gmail.com>"
ADMIN_BOOKING_NOTIFICATION_EMAIL=""
ENABLE_ADMIN_BOOKING_NOTIFICATIONS="true"
